#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int* text_to_bits(const char* text, int text_len, int* out_bit_count) {
    int* bits = malloc(text_len * 8 * sizeof(int));
    int bit_index = 0;
    int i, b;
    
    if (!bits) return NULL;
    
    for (i = text_len - 1; i >= 0; i--) {
        char c = text[i];
        for (b = 0; b < 8; b++) {
            bits[bit_index++] = (c >> b) & 1;
        }
    }
    *out_bit_count = bit_index;
    return bits;
}

void calculate_hamming(const int* data_bits, int m, int r, int* hamming_code) {
    int total_len = m + r;
    int i, j, parity_pos, parity_val;
    
    for (i = 0; i < total_len; i++) {
        hamming_code[i] = 0;
    }
    
    printf("\nPlacing Data Bits\n");
    j = 0;
    for (i = 1; i <= total_len; i++) {
        if ((i & (i - 1)) == 0) {
            /* Power of 2 slot reserved for parity */
            printf("Index %2d: P%d (Reserved for Parity)\n", i, i);
            continue;
        }
        hamming_code[i - 1] = data_bits[j];
        printf("Index %2d: D%d = %d\n", i, j + 1, data_bits[j]);
        j++;
    }
    
    printf("\nCalculating Parity Bits (Even Parity)\n");
    for (i = 0; i < r; i++) {
        parity_pos = 1 << i;
        parity_val = 0;
        
        printf("Calculating P%d (checking indices where bit %d is set):\n", parity_pos, i + 1);
        printf("  ");
        
        for (j = 1; j <= total_len; j++) {
            /* If the parity position bit is set in the current index */
            if (j & parity_pos) {
                /* Skip the parity bit position itself */
                if (j != parity_pos) {
                    printf("%dval:%d ", j, hamming_code[j - 1]);
                    parity_val ^= hamming_code[j - 1];
                }
            }
        }
        hamming_code[parity_pos - 1] = parity_val;
        printf("\n  Result: P%d = %d\n\n", parity_pos, parity_val);
    }

    printf("Final Combined Array Layout\n");
    printf("Position:  ");
    for (i = total_len; i >= 1; i--) {
        if ((i & (i - 1)) == 0) printf("P%-2d ", i);
        else printf("D%-2d ", i); // Note: Labels match standard position tags
    }
    printf("\nBit Value: ");
    for (i = total_len; i >= 1; i--) {
        printf("%-3d ", hamming_code[i - 1]);
    }
    printf("\n");
}

int main() {
    int choice;
    int m = 0; /* Number of input bits */
    int* data_bits = NULL;
    int r, total_len, i;
    int* hamming_code = NULL;
    long filesize, read_bytes;
    char* buffer = NULL;
    FILE* infile = NULL;
    FILE* outfile = NULL;
    char bin_str[4096];
    
    printf("Choose data source:\n");
    printf("1. Read text from 'input.txt' and convert to binary\n");
    printf("2. Enter binary string manually\n");
    printf("Enter choice (1 or 2): ");
    if (scanf("%d", &choice) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    
    if (choice == 1) {
        infile = fopen("input.txt", "rb");
        if (!infile) {
            perror("Error opening input.txt");
            return 1;
        }
        
        fseek(infile, 0, SEEK_END);
        filesize = ftell(infile);
        fseek(infile, 0, SEEK_SET);
        
        if (filesize <= 0) {
            printf("Error: input.txt is empty.\n");
            fclose(infile);
            return 1;
        }
        
        buffer = malloc(filesize + 1);
        read_bytes = fread(buffer, 1, filesize, infile);
        buffer[read_bytes] = '\0';
        fclose(infile);
        
        data_bits = text_to_bits(buffer, read_bytes, &m);
        free(buffer);
    } 
    else if (choice == 2) {
        printf("Enter binary string: ");
        scanf("%4095s", bin_str);
        m = strlen(bin_str);
        data_bits = malloc(m * sizeof(int));
        
        /* Store bits backward to reverse processing orientation */
        for (i = 0; i < m; i++) {
            char bit_char = bin_str[m - 1 - i]; 
            if (bit_char != '0' && bit_char != '1') {
                printf("Error: Invalid binary character '%c'.\n", bit_char);
                free(data_bits);
                return 1;
            }
            data_bits[i] = bit_char - '0';
        }
    } 
    else {
        printf("Invalid choice.\n");
        return 1;
    }
    
    if (m == 0 || !data_bits) {
        printf("No data to process.\n");
        return 1;
    }
    
    /* Determine r based on formula: 2^r >= m + r + 1 */
    r = 0;
    while ((1 << r) < (m + r + 1)) {
        r++;
    }
    total_len = m + r;
    
    hamming_code = malloc(total_len * sizeof(int));
    calculate_hamming(data_bits, m, r, hamming_code);
    
    /* Write to output file */
    outfile = fopen("output", "w");
    if (!outfile) {
        perror("Error opening output file");
        free(data_bits);
        free(hamming_code);
        return 1;
    }
    
    for (i = total_len - 1; i >= 0; i--) {
        fprintf(outfile, "%d", hamming_code[i]);
    }
    fclose(outfile);
    
    printf("\nSuccessfully processed %d data bits.\n", m);
    printf("Added %d parity bits. Total block size: %d bits.\n", r, total_len);
    
    free(data_bits);
    free(hamming_code);
    return 0;
}
