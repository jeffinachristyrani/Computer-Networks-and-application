int main(int argc, char *argv[])
{
    int server_fd, client_fd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t len;

    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0)
    {
        perror("socket");
        return 1;
    }

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(atoi(argv[1]));

    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0)
    {
        perror("bind");
        return 1;
    }

    listen(server_fd, 5);
    printf("Simple Array Server running on port %s...\n", argv[1]);

    len = sizeof(client_addr);

    client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &len);
    if (client_fd < 0)
    {
        perror("accept");
        close(server_fd);
        return 1;
    }

    printf("Client connected. Processing data...\n");

    int count = 0;
    int n1 = recv(client_fd, &count, sizeof(count), 0);
    if (n1 > 0)
    {
        int array[count];
        int n2 = recv(client_fd, array, sizeof(array), 0);
        if (n2 > 0)
        {
            int sum = 0;
            printf("Received Array: ");
            int i;
            for (i = 0; i < count; i++)
            {
                printf("%d ", array[i]);
                sum += array[i]; // Compute sum
            }
            printf("\nCalculated Sum: %d\n", sum);

            char ack[1024];
            snprintf(ack, sizeof(ack), "ACK: Received. Sum is %d", sum);

            send(client_fd, ack, strlen(ack), 0);
            printf("Acknowledgement response sent.\n");
        }
    }

    close(client_fd);
    close(server_fd);

    printf("Server job complete. Exiting cleanly.\n");
    return 0;
}

