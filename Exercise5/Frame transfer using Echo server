        while (f_idx < packet_size)
        {
            strncpy(current_payload_frame, current_packet + f_idx, frame_size);
            current_payload_frame[frame_size] = '\0';

            if ((int)strlen(current_payload_frame) < frame_size)
            {
                int short_by = frame_size - strlen(current_payload_frame);
                for (i = 0; i < short_by; i++)
                {
                    strcat(current_payload_frame, "0");
