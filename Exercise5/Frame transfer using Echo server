void read_file_to_binary(const char *filename, char *payload_bin, int *original_bit_len)
{
    FILE *file;
    int ch;
    char byte_bin[9];

    file = fopen(filename, "r");
    if (!file)
    {
        perror("File open failed");
        exit(1);
    }
    payload_bin[0] = '\0';
    while ((ch = fgetc(file)) != EOF)
    {
        byte_to_binary_str((unsigned char)ch, byte_bin);
        strcat(payload_bin, byte_bin);
    }
    fclose(file);
    *original_bit_len = strlen(payload_bin);
    printf("Step 1 (Full Payload Binary): %s\n", payload_bin);
    printf("Original Message Bit Length (Multiple of 8): %d bits\n", *original_bit_len);
}

void select_protocol(char *proto_bin)
{
    int choice;
    printf("\nSelect PPP Protocol:\n1. IPv4\n2. IPv6\n3. LCP\n4. PAP\n5. CHAP\n6. IPCP\nChoice: ");
    if (scanf("%d", &choice) != 1) exit(1);

    switch (choice)
    {
        case 1: strcpy(proto_bin, "0000000000100001"); break;
        case 2: strcpy(proto_bin, "0000000001010111"); break;
        case 3: strcpy(proto_bin, "1100000000100001"); break;
        case 4: strcpy(proto_bin, "1100000000100011"); break;
        case 5: strcpy(proto_bin, "1100001000100011"); break;
        case 6: strcpy(proto_bin, "1000000000100001"); break;
        default: strcpy(proto_bin, "0000000000100001"); break;
    }
    printf("Step 2 (Protocol Bits): %s\n", proto_bin);
}

void perform_byte_stuffing(const char *un_stuffed, char *stuffed)
{
    int i;
    int len;
    char current_byte[9];
    const char *flag = "01111110";
    const char *escape = "01111101";

    len = strlen(un_stuffed);
    strcpy(stuffed, flag);
    current_byte[8] = '\0';

    for (i = 0; i < len; i += 8)
    {
        strncpy(current_byte, un_stuffed + i, 8);
        if (strcmp(current_byte, flag) == 0 || strcmp(current_byte, escape) == 0)
        {
            strcat(stuffed, escape);
        }
        strcat(stuffed, current_byte);
    }
    strcat(stuffed, flag);
}

