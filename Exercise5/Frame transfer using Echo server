            printf("Payload Frame Content: %s\n", current_payload_frame);

            sprintf(un_stuffed_frame, "1111111100000011%s%s", proto_bin, current_payload_frame);

            calculate_binary_checksum(un_stuffed_frame, fcs_bin);
            printf("Step 4: %s\n", fcs_bin);

            strcat(un_stuffed_frame, fcs_bin);
            perform_byte_stuffing(un_stuffed_frame, stuffed_frame);
            printf("Step 5 (After byte stuffing):\n%s\n", stuffed_frame);
            inject_error_if_requested(stuffed_frame);

            int frame_len = strlen(stuffed_frame);
            send(sockfd, &frame_len, sizeof(frame_len), 0);
            usleep(1000);
            send(sockfd, stuffed_frame, frame_len, 0);
            usleep(5000);

            f_idx += frame_size;
            current_frame_count++;
        }
        p_idx += packet_size;
    }

    int stop_signal = -1;
    send(sockfd, &stop_signal, sizeof(stop_signal), 0);

    printf("\nTransmission complete. Closing connection.\n");
    close(sockfd);
    return 0;
}

