#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 4096

unsigned char binary_str_to_byte(const char *bin_str)
{
    unsigned char byte = 0;
    int i;

    for (i = 0; i < 8; i++)
    {
        byte <<= 1;
        if (bin_str[i] == '1') byte |= 1;
    }
    return byte;
}

void binary_add_16bit(const char *bin1, const char *bin2, char *result)
{
    int carry = 0;
    int sum;
    int i;
    char temp[17];

    for (i = 15; i >= 0; i--)
    {
        sum = (bin1[i] - '0') + (bin2[i] - '0') + carry;
        temp[i] = (sum % 2) + '0';
        carry = sum / 2;
    }

    if (carry > 0)
    {
        char carry_str[] = "0000000000000001";
        carry = 0;
        for (i = 15; i >= 0; i--)
        {
            sum = (temp[i] - '0') + (carry_str[i] - '0') + carry;
            result[i] = (sum % 2) + '0';
            carry = sum / 2;
        }
    }
    else
    {
        strcpy(result, temp);
    }
    result[16] = '\0';
}

void calculate_binary_checksum(const char *binary_frame, char *checksum_out)
{
    char total_sum[17];
    char current_word[17];
    int len = strlen(binary_frame);
    int i;
    int j;

    strcpy(total_sum, "0000000000000000");
    current_word[16] = '\0';

    for (i = 0; i < len; i += 16)
    {
        for (j = 0; j < 16; j++)
        {
            current_word[j] = (i + j < len) ? binary_frame[i + j] : '0';
        }
        binary_add_16bit(total_sum, current_word, total_sum);
    }

    for (i = 0; i < 16; i++)
    {
        checksum_out[i] = (total_sum[i] == '0') ? '1' : '0';
    }
    checksum_out[16] = '\0';
}

// --- PPP Frame Processing Functions ---

void perform_byte_destuffing(const char *rx_buffer, char *de_stuffed)
{
    char current_byte[9];
    char core_stuffed[BUFFER_SIZE] = {0};
    const char *escape = "01111101";
    int core_len;
    int i;

    strncpy(core_stuffed, rx_buffer + 8, strlen(rx_buffer) - 16);
    core_stuffed[strlen(rx_buffer) - 16] = '\0';

    core_len = strlen(core_stuffed);
    de_stuffed[0] = '\0';
    current_byte[8] = '\0';

    for (i = 0; i < core_len; i += 8)
    {
        strncpy(current_byte, core_stuffed + i, 8);
        if (strcmp(current_byte, escape) == 0)
        {
            i += 8;
            strncpy(current_byte, core_stuffed + i, 8);
        }
        strcat(de_stuffed, current_byte);
    }
}

int verify_and_extract_payload(const char *de_stuffed, char *extracted_payload, char *proto_bits)
{
    char extracted_data[2048] = {0};
    char received_fcs[17] = {0};
    char recalculated_fcs[17] = {0};
    int data_len;

    data_len = strlen(de_stuffed) - 16;
    strncpy(extracted_data, de_stuffed, data_len);
    extracted_data[data_len] = '\0';
    strcpy(received_fcs, de_stuffed + data_len);

    calculate_binary_checksum(extracted_data, recalculated_fcs);
    printf("Step 4:\nReceived FCS:     %s\nCalculated FCS: %s\n", received_fcs, recalculated_fcs);

    if (strcmp(recalculated_fcs, received_fcs) != 0)
    {
        printf("\nERROR DETECTED: frame discarded.\n");
        return 0;
    }

    printf("\nNO ERROR DETECTED: No errors detected.\n");
    strncpy(proto_bits, extracted_data + 16, 16);
    proto_bits[16] = '\0';

    strcpy(extracted_payload, extracted_data + 32);
    return 1;
}

void print_final_results(const char *payload_stream, int bit_len)
{
    char single_byte_str[9] = {0};
    int i;
    printf("FINAL EXTRACTED PAYLOAD AND DECODED MESSAGE\n");
    printf("FINAL PAYLOAD (BITS): %s\n", payload_stream);
    printf("Decoded File Message: ");

    for (i = 0; i < bit_len; i += 8)
    {
        memset(single_byte_str, 0, sizeof(single_byte_str));
        strncpy(single_byte_str, payload_stream + i, 8);

        if (strlen(single_byte_str) == 8)
        {
            unsigned char decoded_char = binary_str_to_byte(single_byte_str);
            if (decoded_char != '\0')
            {
                printf("%c", decoded_char);
            }
        }
    }
    print("\n")
}
int setup_server_socket(const char *port)
{
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    int opt = 1;
    struct sockaddr_in server_addr;

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(atoi(port));

    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0)
    {
        return -1;
    }
    listen(server_fd, 5);
    printf("Byte-Stuffing PPP Server active on port %s\n", port);
    return server_fd;
}

void handle_client_stream(int client_fd, int packet_size, int frame_size, int original_bit_len)
{
    char rx_buffer[BUFFER_SIZE] = {0};
    char de_stuffed[BUFFER_SIZE] = {0};
    char current_extracted_payload[2048] = {0};
    char proto_bits[17] = {0};

    // Intermediate structures for layered decoding
    char master_payload_collector[8192] = {0};
    char current_packet_collector[4096] = {0};

    int rx_len;
    int current_frame_count = 1;

    // A clean de-stuffed frame contains Address/Control(16) + Proto(16) + Payload + FCS(16)
    // Therefore, the payload capacity of a single frame is: frame_size - 48 bits.
    int frame_payload_capacity = frame_size - 48;
    int total_msg_bits_remaining = original_bit_len;

    while (1)
    {
        if (recv(client_fd, &rx_len, sizeof(rx_len), 0) <= 0 || rx_len == -1) break;

        recv(client_fd, rx_buffer, rx_len, 0);
        rx_buffer[rx_len] = '\0';

        printf("\nReceiving Frame %d\n", current_frame_count);
        printf("Raw fram bits recieved:\n%s\n", rx_buffer);

        perform_byte_destuffing(rx_buffer, de_stuffed);
        printf("Frame bits after removing padding bits and stuffing:\n%s\n", de_stuffed);

        if (verify_and_extract_payload(de_stuffed, current_extracted_payload, proto_bits))
        {
            printf("Protocol Header Bits: %s\n", proto_bits);
            printf("Extracted Payload Bit segment): %s\n", current_extracted_payload);
            int current_packet_bits_remaining = packet_size - strlen(current_packet_collector);
            int valid_frame_payload_len = frame_payload_capacity;
            if (current_packet_bits_remaining < frame_payload_capacity)
            {
                valid_frame_payload_len = current_packet_bits_remaining;
            }

            current_extracted_payload[valid_frame_payload_len] = '\0';
            strcat(current_packet_collector, current_extracted_payload);
            if ((int)strlen(current_packet_collector) >= packet_size || total_msg_bits_remaining <= packet_size)
            {
                int valid_packet_len = packet_size;
                if (total_msg_bits_remaining < packet_size)
                {
                    valid_packet_len = total_msg_bits_remaining;
                }

                current_packet_collector[valid_packet_len] = '\0';
                strcat(master_payload_collector, current_packet_collector);

                total_msg_bits_remaining -= valid_packet_len;
                current_packet_collector[0] = '\0';
            }
        }
        current_frame_count++;
    }
    print_final_results(master_payload_collector, original_bit_len);
}

int main(int argc, char *argv[])
{
    int server_fd;
    int client_fd;
    int packet_size;
    int frame_size;
    int original_bit_len;
    struct sockaddr_in client_addr;
    socklen_t addr_len;

    if (argc != 2) return 1;

    server_fd = setup_server_socket(argv[1]);
    if (server_fd < 0) return 1;

    addr_len = sizeof(client_addr);
    client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &addr_len);
    printf("Client network channel link accepted.\n");

    recv(client_fd, &packet_size, sizeof(packet_size), 0);
    recv(client_fd, &frame_size, sizeof(frame_size), 0);
    recv(client_fd, &original_bit_len, sizeof(original_bit_len), 0);
    printf("Parameters\nPacket: %d bits \nFrame: %d bits  \nMessage Size: %d bits\n", packet_size, frame_size, original_bit_len);

    handle_client_stream(client_fd, packet_size, frame_size, original_bit_len);

    close(client_fd);
    close(server_fd);
    return 0;
}

