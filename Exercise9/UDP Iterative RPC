#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 5001
#define BUFFER_SIZE 1024

int main() {
    int client_fd;
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    struct sockaddr_in server_addr;
    socklen_t addr_len = sizeof(server_addr);

    // 1. Create UDP socket
    if ((client_fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("172.16.16.200");

    printf("=== Remote Procedure Call (RPC) Client ===\n");
    printf("Available remote calls:\n");
    printf("  add num1 num2\n");
    printf("  sub num1 num2\n");
    printf("  mul num1 num2\n");
    printf("  div num1 num2\n");
    printf("  pow base exponent\n");
    printf("Type 'exit' to terminate client application.\n\n");

    while (1) {
        printf("Enter RPC invocation string: ");
        fgets(buffer, BUFFER_SIZE, stdin);

        buffer[strcspn(buffer, "\n")] = 0;

        if (strcmp(buffer, "exit") == 0) {
            printf("Closing client connection.\n");
            break;
        }

        if (strlen(buffer) == 0) {
            continue;
        }

        sendto(client_fd, buffer, strlen(buffer), 0, (const struct sockaddr *)&server_addr, addr_len);

        memset(response, 0, BUFFER_SIZE);
        int len = recvfrom(client_fd, response, BUFFER_SIZE, 0, (struct sockaddr *)&server_addr, &addr_len);
        response[len] = '\0';

        printf("Server Response: %s\n\n", response);
    }

    close(client_fd);
    return 0;
}

