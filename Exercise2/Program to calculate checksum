    if (scanf("%d", &frame_size) != 1 || frame_size <= 0) return;
    printf("\n--- PPP Layer Protocol Selection ---\n");
    printf("1. TCP  (0000000000000110)\n");
    printf("2. UDP  (0000000000010001)\n");
    printf("3. IPv4 (0000100000000000)\n");
    printf("4. IPv6 (1000011011011101)\n");
    printf("5. LCP  (1100000000100001)\n");
    printf("6. NCP  (1000000000100001)\n");
    printf("Select Protocol choice (1-6): ");
    int proto_choice;
    if (scanf("%d", &proto_choice) != 1) proto_choice = 1;
    char protocol_bits[17] = "0000000000000000";
    switch (proto_choice) {
        case 1: strcpy(protocol_bits, "0000000000000110"); break;
        case 2: strcpy(protocol_bits, "0000000000010001"); break;
        case 3: strcpy(protocol_bits, "0000100000000000"); break;
        case 4: strcpy(protocol_bits, "1000011011011101"); break;
        case 5: strcpy(protocol_bits, "1100000000100001"); break;
        case 6: strcpy(protocol_bits, "1000000000100001"); break;
        default: strcpy(protocol_bits, "1100000000100001"); break;
    }
    int text_bit_index = 0;
    int packet_count = 1;
    while (text_bit_index < total_text_bits) {
        char current_packet_bits[512] = "";

        for (i = 0; i < packet_size; i++) {
            if (text_bit_index < total_text_bits) {
                current_packet_bits[i] = binaryMessage[text_bit_index];
                text_bit_index++;
