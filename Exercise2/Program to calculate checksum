    scanf("%255s", src_url);
    printf("Enter Destination URL: ");
    scanf("%255s", dest_url);
    int i;
    for (i = 0; i < currentCount; i++) {
        if (strcmp(netArray[i].url, src_url) == 0) {
            strcpy(src_ip, netArray[i].ip_address);
            strcpy(src_mac, netArray[i].mac_address);
            src_found = 1;
        }
        if (strcmp(netArray[i].url, dest_url) == 0) {
            strcpy(dest_ip, netArray[i].ip_address);
            strcpy(dest_mac, netArray[i].mac_address);
            dest_found = 1;
        }
    }
    if (!src_found || !dest_found) {
        printf("Error: Source or Destination URL not found in the network table.\n");
        return;
    }
    printf("Enter the filename to read text from: ");
    scanf("%99s", filename);
    char *fileContent = readFileContent(filename);
    if (fileContent != NULL) {
        unsigned int src_port = 0;
        unsigned int dest_port = 0;
        ApplicationLayer(fileContent);
        TransportLayer(fileContent, &src_port, &dest_port);
        NetworkLayer(src_ip, dest_ip, src_port, dest_port, fileContent);
        datalinkLayer(src_mac, dest_mac, src_ip, dest_ip, src_port, dest_port, fileContent,0,0);
        free(fileContent);
    }
}
