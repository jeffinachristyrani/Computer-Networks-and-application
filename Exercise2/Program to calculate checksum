void convertMACToBinary(const char *mac_str) {
    unsigned int bytes[4];
    if (sscanf(mac_str, "%x:%x:%x:%x", &bytes[0], &bytes[1], &bytes[2], &bytes[3]) != 4) {
        printf("00000000000000000000000000000000");
        return;
    }
    int i,j;
    for (i = 0; i < 4; i++) {
        for (j = 7; j >= 0; j--) {
            int bit = (bytes[i] >> j) & 1;
            printf("%d", bit);
        }
    }
}
void printBinary16(unsigned int value) {
    int i;
    for (i = 15; i >= 0; i--) {
        printf("%c", (value & (1 << i)) ? '1' : '0');
    }
}
void calculatePPPChecksum(const char *address, const char *control, const char *protocol, const char *data, char *fcs_out) {
    char full_payload[2048] = "";
    strcat(full_payload, address);    
    strcat(full_payload, control);
    strcat(full_payload, protocol);
    strcat(full_payload, data);
    printf("Address  : %s\n", address);
    printf("Control  : %s\n", control);
    printf("Protocol : %s\n", protocol);
    printf("Data     : %s\n", data);
    printf("\nCombined Payload:\n%s\n", full_payload);
    int total_bits = strlen(full_payload);
    printf("\nTotal Payload Length = %d bits\n", total_bits);
    unsigned long sum = 0;
    int i, j;
    for (i = 0; i < total_bits; i += 16) {
        unsigned int block_val = 0;
        unsigned int previousSum = (unsigned int)sum;
        for (j = 0; j < 16; j++) {
            block_val <<= 1;
            if ((i + j) < total_bits) {
                if (full_payload[i + j] == '1')
                    block_val |= 1;
            }
        }
        printf("\nBlock %2d : ", (i / 16) + 1);
        printBinary16(block_val);
        printf("\nPrevious Sum : ");
        printBinary16(previousSum);
        printf("\nAdd Block    : ");
        printBinary16(block_val);
        sum += block_val;
        if (sum > 0xFFFF) {
            int k;
            for (k = 16; k >= 0; k--)
                printf("%c", (sum & (1UL << k)) ? '1' : '0');
        } else {
            printBinary16((unsigned int)sum);
        }
        printf("\n");
    }
    printf("\n------------ CARRY FOLDING ------------\n");
    while (sum >> 16) {
        printf("\nCurrent Sum : ");
        if (sum > 0xFFFF) {
            int k;
            for (k = 16; k >= 0; k--)
                printf("%c", (sum & (1UL << k)) ? '1' : '0');
        } else {
            printBinary16((unsigned int)sum);
        }
        printf("\nCarry       : ");
        printBinary16((unsigned int)(sum >> 16));
        sum = (sum & 0xFFFF) + (sum >> 16);
        printf("\nAfter Fold  : ");
        printBinary16((unsigned int)sum);
        printf("\n");
    }
    printf("\nFinal Sum          : ");
    printBinary16((unsigned int)sum);
    unsigned int checksum = ~sum & 0xFFFF;
    printf("\nOne's Complement   : ");
    printBinary16(checksum);
    for (i = 15; i >= 0; i--) {
        fcs_out[i] = (checksum & 1) ? '1' : '0';
        checksum >>= 1;
    }
    fcs_out[16] = '\0';
    printf("\nFinal PPP Checksum : %s\n", fcs_out);
    printf("================ END OF CHECKSUM CALCULATION ================\n");
}
void pppLayer(const char *frame_data, int frame_size, const char *protocol_bits) {
    const char *flag = "01111110";
    const char *address = "11111111";
    const char *control = "00000011";
    char fcs[17];
    calculatePPPChecksum(address, control, protocol_bits, frame_data, fcs);
    printf("\n    [PPP FRAME OUTPUT]\n");
    printf("    Flag:     %s\n", flag);
    printf("    Address:  %s\n", address);
    printf("    Control:  %s\n", control);
    printf("    Protocol: %s\n", protocol_bits);
    printf("    Data:     %s\n", frame_data);
    printf("    FCS:      %s\n", fcs);
    printf("    Flag:     %s\n", flag);
    FILE *file = fopen("ppp_output.txt", "a");
    if (file != NULL) {
        fprintf(file, "%s %s %s %s %s %s %s\n", flag, address, control, protocol_bits, frame_data, fcs, flag);
        fclose(file);
    } else {
        printf("    Error: Could not save PPP frame data to file.\n");
    }
}
void datalinkLayer(const char *src_mac, const char *dest_mac, const char *src_ip, const char *dest_ip,
                   unsigned int src_port, unsigned int dest_port, const char *text,
                   int choice, int checksum_n) {
    printf("\n--- Data Link Layer Execution ---\n");
    int i, j;
    char binaryMessage[4096] = "";
    for (i = 0; text[i] != '\0'; i++) {
        char ch = text[i];
        for (j = 7; j >= 0; j--) {
            int bit = (ch >> j) & 1;
            char bit_str[2];
            sprintf(bit_str, "%d", bit);
            strcat(binaryMessage, bit_str);
        }
    }
    int total_text_bits = strlen(binaryMessage);
    int packet_size = 0;
