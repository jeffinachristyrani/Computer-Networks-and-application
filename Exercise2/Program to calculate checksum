        printf("\n======================================================================\n");
        printf(" PROCESSING PACKET #%d (Data Size: %d bits)\n", packet_count++, packet_size);
        printf("======================================================================\n");
        int packet_bit_index = 0;
        int frame_count = 1;
        int total_packet_bits = strlen(current_packet_bits);
        while (packet_bit_index < total_packet_bits) {
            char current_frame_bits[512] = "";
            int k;
            for (k = 0; k < frame_size; k++) {
                if (packet_bit_index < total_packet_bits) {
