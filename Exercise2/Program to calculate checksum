void splitAndPrintPackets(const char *src_ip, const char *dest_ip, unsigned int src_port, unsigned int dest_port, const char *text) {
    char binaryMessage[32768] = ""; // Large buffer to hold text bits
    int i,j;
    for (i = 0; text[i] != '\0'; i++) {
        char ch = text[i];
        for (j = 7; j >= 0; j--) {
            int bit = (ch >> j) & 1;
            char bit_str[2];
            sprintf(bit_str, "%d", bit);
            strcat(binaryMessage, bit_str);
        }
    }
    int total_bits = strlen(binaryMessage);
    int packet_size = 0;
    printf("\nEnter packet data chunk size (in bits, e.g., 8, 16, 24, 32): ");
    if (scanf("%d", &packet_size) != 1 || packet_size <= 0) {
        printf("Invalid packet size.\n");
        return;
    }
    printf("\n=== Fragmented Network Packets ===\n");
    int bit_index = 0;
    int packet_count = 1;
    while (bit_index < total_bits) {
        char current_packet_data[1024] = "";
        for (i = 0; i < packet_size; i++) {
            if (bit_index < total_bits) {
                char bit_str[2] = { binaryMessage[bit_index], '\0' };
                strcat(current_packet_data, bit_str);
                bit_index++;
            } else {
                strcat(current_packet_data, "0");
            }
        }
        printf("Packet #%d Layout:\n", packet_count++);
        convertIPToBinary(src_ip);
        printf(" ");
        convertIPToBinary(dest_ip);
        printf(" ");
        convertPortToBinary(src_port);
        printf(" ");
        convertPortToBinary(dest_port);
        printf(" ");
        printf("%s\n", current_packet_data);
        printf("--------------------------------------------------\n");
    }
}
void convertIPToBinary(const char *ip_str) {
    int octets[4];
    if (sscanf(ip_str, "%d.%d.%d.%d", &octets[0], &octets[1], &octets[2], &octets[3]) != 4) {
        printf("Invalid IP address format.\n");
        return;
    }
    printf("IP Binary: ");
    int i,j;
    for (i = 0; i < 4; i++) {
        // Convert each integer segment to 8-bit binary
        for (j = 7; j >= 0; j--) {
            int bit = (octets[i] >> j) & 1;
            printf("%d", bit);
        }
        if (i < 3) printf(" "); // Separate binary segments with dots
    }
    printf("\n");
}
