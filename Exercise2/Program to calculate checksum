#define MAX_FRAME_LEN 8192
void get_8_bits(const char *src, int index, char *dest) {
    strncpy(dest, &src[index], 8);
    dest[8] = '\0';
}
void stuffPPPFrames() {
    FILE *infile = fopen("ppp_output.txt", "r");
    FILE *outfile = fopen("ppp_stuffed_output.txt", "w");
    int i,j; 
    if (!infile) {
        printf("\nError: Could not open ppp_output.txt for stuffing.\n");
        return;
    }
    if (!outfile) {
        printf("\nError: Could not create ppp_stuffed_output.txt.\n");
        fclose(infile);
        return;
    }
    printf("\n=== EXECUTING CHARACTER STUFFING ===\n");
    char line[MAX_FRAME_LEN];
    while (fgets(line, sizeof(line), infile)) {
        line[strcspn(line, "\r\n")] = '\0';
        if (strlen(line) < 16) continue; // Skip invalid short lines
        char raw_frame[MAX_FRAME_LEN] = "";
        for (i = 0; line[i] != '\0'; i++) {
            if (line[i] != ' ') {
                int len = strlen(raw_frame);
                raw_frame[len] = line[i];
                raw_frame[len + 1] = '\0';
            }
        }
        int total_bits = strlen(raw_frame);
        char stuffed_frame[MAX_FRAME_LEN] = "";
        char start_flag[9];
        get_8_bits(raw_frame, 0, start_flag);
        strcat(stuffed_frame, start_flag);
        char current_byte[9];
        for (i = 8; i < total_bits - 8; i += 8) {
            get_8_bits(raw_frame, i, current_byte);
            if (strcmp(current_byte, "01111110") == 0 || strcmp(current_byte, "01111101") == 0) {
                strcat(stuffed_frame, "01111101");
            }
            strcat(stuffed_frame, current_byte);
        }
        char end_flag[9];
        get_8_bits(raw_frame, total_bits - 8, end_flag);
        strcat(stuffed_frame, end_flag);

        // Print & Save Outputs
        printf("Original: %s\n", raw_frame);
        printf("Stuffed:  %s\n\n", stuffed_frame);
        fprintf(outfile, "%s\n", stuffed_frame);
    }

    fclose(infile);
    fclose(outfile);
    printf("Stuffing completed. Saved to ppp_stuffed_output.txt\n");
}

void Executer(void) {
    char filename[100];
    char src_url[256];
    char dest_url[256];
