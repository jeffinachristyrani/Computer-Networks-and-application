#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <pthread.h>

#define BUFFER_SIZE 1024

int client_fd;
struct sockaddr_in server_addr;

void *receive_messages(void *arg) {
    char buffer[BUFFER_SIZE];
    socklen_t addr_len = sizeof(server_addr);
    int len;

    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        len = recvfrom(client_fd, buffer, BUFFER_SIZE - 1, 0, (struct sockaddr *)&server_addr, &addr_len);

        if (len > 0) {
            buffer[len] = '\0';
            // Clear current prompt line before outputting incoming data
            printf("\r%s\n> ", buffer);
            fflush(stdout);
        } else if (len < 0) {
            perror("\nError reading from server");
            break;
        }
    }
    return NULL;
}

int main(int argc, char *argv[]) {
    char *server_ip;
    int port;
    char username[50];
    char msg_buffer[BUFFER_SIZE];
    char formatted_msg[BUFFER_SIZE + 60];
    pthread_t recv_thread;

    if (argc != 3) {
        fprintf(stderr, "Usage: %s <Server IP> <Server Port>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    server_ip = argv[1];
    port = atoi(argv[2]);

    printf("Enter your username: ");
    if (fgets(username, sizeof(username), stdin) == NULL) return 0;
    username[strcspn(username, "\n")] = '\0';

    if ((client_fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);

    if (inet_pton(AF_INET, server_ip, &server_addr.sin_addr) <= 0) {
        perror("Invalid address / Address not supported");
        exit(EXIT_FAILURE);
    }

    if (pthread_create(&recv_thread, NULL, receive_messages, NULL) != 0) {
        perror("Failed to create receiving thread");
        close(client_fd);
        exit(EXIT_FAILURE);
    }

    printf("--- Connected to UDP Chat Server at %s:%d! ---\n", server_ip, port);

    sprintf(formatted_msg, "%s has joined the chat room.", username);
    sendto(client_fd, formatted_msg, strlen(formatted_msg), 0, (const struct sockaddr *)&server_addr, sizeof(server_addr));

    while (1) {
        printf("> ");
        fflush(stdout);

        if (fgets(msg_buffer, sizeof(msg_buffer), stdin) == NULL) break;
        msg_buffer[strcspn(msg_buffer, "\n")] = '\0';

        if (strlen(msg_buffer) == 0) continue;

        if (strcmp(msg_buffer, "exit") == 0) {
            sprintf(formatted_msg, "%s has left the chat room.", username);
            sendto(client_fd, formatted_msg, strlen(formatted_msg), 0, (const struct sockaddr *)&server_addr, sizeof(server_addr));
            break;
        }

        sprintf(formatted_msg, "%s: %s", username, msg_buffer);
        sendto(client_fd, formatted_msg, strlen(formatted_msg), 0, (const struct sockaddr *)&server_addr, sizeof(server_addr));
    }

    pthread_cancel(recv_thread);
    close(client_fd);
    printf("Disconnected.\n");
    return 0;
}

