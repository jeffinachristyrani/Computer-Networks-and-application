#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 1024
#define TABLE_SIZE 17

typedef struct DNSEntry {
    char url[256];
    char ip[64];
    struct DNSEntry *next;
} DNSEntry;

DNSEntry *hash_table[TABLE_SIZE] = {NULL};

unsigned int hash(const char *str) {
    unsigned int h = 0;

    while (*str)
        h = (h << 5) + *str++;

    return h % TABLE_SIZE;
}

void insert_dns(const char *url, const char *ip) {
    unsigned int index = hash(url);

    DNSEntry *new_entry = malloc(sizeof(DNSEntry));

    strcpy(new_entry->url, url);
    strcpy(new_entry->ip, ip);

    new_entry->next = hash_table[index];
    hash_table[index] = new_entry;
}

const char *lookup_dns(const char *url) {
    unsigned int index = hash(url);
    DNSEntry *curr = hash_table[index];

    while (curr != NULL) {
        if (strcmp(curr->url, url) == 0)
            return curr->ip;

        curr = curr->next;
    }

    return "NOT_FOUND";
}

void init_dns_table() {
    insert_dns("google.com", "142.250.190.46");
    insert_dns("github.com", "140.82.121.4");
    insert_dns("openai.com", "104.18.23.238");
    insert_dns("wikipedia.org", "198.35.26.96");
}

int main(int argc, char *argv[]) {

    if (argc != 2) {
        fprintf(stderr, "Usage: %s <Port>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    int port = atoi(argv[1]);
    int server_fd;
    char buffer[BUFFER_SIZE];

    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);

    init_dns_table();

    server_fd = socket(AF_INET, SOCK_DGRAM, 0);

    if (server_fd < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(port);

    if (bind(server_fd, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {

        perror("Bind failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    printf("--- UDP DNS Server started on port %d ---\n", port);

    while (1) {

        memset(buffer, 0, BUFFER_SIZE);

        int len = recvfrom(server_fd, buffer, BUFFER_SIZE - 1, 0,
                           (struct sockaddr *)&client_addr,
                           &addr_len);

        if (len < 0)
            continue;

        buffer[len] = '\0';

        /*
         * ADD request format:
         * ADD|url|ip
         */
        if (strncmp(buffer, "ADD|", 4) == 0) {

            char *url = strtok(buffer + 4, "|");
            char *ip = strtok(NULL, "|");

            if (url != NULL && ip != NULL) {

                insert_dns(url, ip);

                printf("[NEW ENTRY] %s -> %s\n", url, ip);

                sendto(server_fd, "ADDED", 5, 0,
                       (struct sockaddr *)&client_addr,
                       addr_len);
            }

            continue;
        }

        printf("[LOOKUP REQUEST] URL: '%s' from %s:%d\n",
               buffer,
               inet_ntoa(client_addr.sin_addr),
               ntohs(client_addr.sin_port));

        const char *resolved_ip = lookup_dns(buffer);

        printf("[RESPONSE SENT] IP: %s\n", resolved_ip);

        sendto(server_fd, resolved_ip, strlen(resolved_ip), 0,
               (struct sockaddr *)&client_addr,
               addr_len);
    }

    close(server_fd);
    return 0;
}
