#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 1024

int main(int argc, char *argv[]) {

    if (argc != 3) {
        fprintf(stderr, "Usage: %s <Server IP> <Server Port>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    char *server_ip = argv[1];
    int port = atoi(argv[2]);

    int client_fd;
    char url_buffer[BUFFER_SIZE];
    char ip_buffer[BUFFER_SIZE];
    char choice[10];

    struct sockaddr_in server_addr;
    socklen_t addr_len = sizeof(server_addr);

    client_fd = socket(AF_INET, SOCK_DGRAM, 0);

    if (client_fd < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);

    if (inet_pton(AF_INET, server_ip, &server_addr.sin_addr) <= 0) {
        perror("Invalid server address");
        exit(EXIT_FAILURE);
    }

    printf("--- DNS Query Client Terminal ---\n");

    while (1) {

        printf("Enter URL to resolve (or type 'exit'): ");

        if (fgets(url_buffer, sizeof(url_buffer), stdin) == NULL)
            break;

        url_buffer[strcspn(url_buffer, "\n")] = '\0';

        if (strlen(url_buffer) == 0)
            continue;

        if (strcmp(url_buffer, "exit") == 0)
            break;

        /* Send URL to server */
        sendto(client_fd, url_buffer, strlen(url_buffer), 0,
               (struct sockaddr *)&server_addr, addr_len);

        memset(ip_buffer, 0, BUFFER_SIZE);

        int len = recvfrom(client_fd, ip_buffer,
                           BUFFER_SIZE - 1, 0,
                           (struct sockaddr *)&server_addr,
                           &addr_len);

        if (len <= 0) {
            perror("Failed to get response");
            continue;
        }

        ip_buffer[len] = '\0';

        /* If URL is not found */
        if (strcmp(ip_buffer, "NOT_FOUND") == 0) {

            printf("Host '%s' not found.\n", url_buffer);

            printf("Do you want to add it to the DNS table? (y/n): ");
            fgets(choice, sizeof(choice), stdin);

            if (choice[0] == 'y' || choice[0] == 'Y') {

                char ip[64];
                char add_request[BUFFER_SIZE];

                printf("Enter IP address: ");
                fgets(ip, sizeof(ip), stdin);

                ip[strcspn(ip, "\n")] = '\0';

                /*
                 * Create:
                 * ADD|url|ip
                 */
                snprintf(add_request, sizeof(add_request),
                         "ADD|%s|%s", url_buffer, ip);

                sendto(client_fd, add_request,
                       strlen(add_request), 0,
                       (struct sockaddr *)&server_addr,
                       addr_len);

                memset(ip_buffer, 0, BUFFER_SIZE);

                len = recvfrom(client_fd, ip_buffer,
                               BUFFER_SIZE - 1, 0,
                               (struct sockaddr *)&server_addr,
                               &addr_len);

                if (len > 0) {

                    ip_buffer[len] = '\0';

                    if (strcmp(ip_buffer, "ADDED") == 0)
                        printf("Successfully added: %s -> %s\n\n",
                               url_buffer, ip);
                }
            }
            else {
                printf("Entry was not added.\n\n");
            }
        }
        else {
            printf("Result: %s -> %s\n\n",
                   url_buffer, ip_buffer);
        }
    }

    close(client_fd);
    return 0;
}
