#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define SERV_PORT 8080
#define BUFFER_SIZE 65536
#define MAX_SUBNETS 64
#define MAX_IPS 65536

// Helper function to calculate total addresses from a given subnet prefix length
unsigned long long prefix_to_addresses(int prefix) {
    if (prefix < 0 || prefix > 32) return 0;
    return 1ULL << (32 - prefix);
}

// Function to round up a number to the nearest highest power of 2
unsigned long long round_to_next_power_of_two(unsigned long long n) {
    if (n == 0) return 1;
    if ((n & (n - 1)) == 0) return n;

    n--;
    n |= n >> 1;
    n |= n >> 2;
    n |= n >> 4;
    n |= n >> 8;
    n |= n >> 16;
    n |= n >> 32;

    return n + 1;
}

// Helper to convert uint32_t to a structured IPv4 dotted string
void ip_to_str(uint32_t ip, char *buffer) {
    struct in_addr addr;
    addr.s_addr = htonl(ip);
    strcpy(buffer, inet_ntoa(addr));
}

// Helper to convert an integer prefix to a dotted subnet mask string
void prefix_to_mask_str(int prefix, char *mask_str) {
    uint32_t mask;

    if (prefix == 0)
        mask = 0;
    else
        mask = (~0U << (32 - prefix));

    ip_to_str(mask, mask_str);
}

// Check whether an IP has already been allocated
int is_ip_allocated(uint32_t ip,
                    uint32_t allocated_ips[],
                    int total_allocated) {
    int i;

    for (i = 0; i < total_allocated; i++) {
        if (allocated_ips[i] == ip)
            return 1;
    }

    return 0;
}

// Find the client that owns an IP
int find_ip_owner(uint32_t ip,
                  uint32_t allocated_ips[],
                  char allocated_clients[][100],
                  int total_allocated,
                  char *owner) {
    int i;

    for (i = 0; i < total_allocated; i++) {
        if (allocated_ips[i] == ip) {
            strcpy(owner, allocated_clients[i]);
            return 1;
        }
    }

    return 0;
}

// Find first available usable IP in a subnet
uint32_t find_available_ip(uint32_t network,
                           uint32_t broadcast,
                           uint32_t allocated_ips[],
                           int total_allocated) {
    uint32_t ip;

    for (ip = network + 1; ip < broadcast; ip++) {
        if (!is_ip_allocated(ip, allocated_ips, total_allocated))
            return ip;
    }

    return 0;
}

// Display availability on SERVER side
void display_ip_availability(int num_subnets,
                             uint32_t subnet_networks[],
                             uint32_t subnet_broadcasts[],
                             uint32_t allocated_ips[],
                             char allocated_clients[][100],
                             int total_allocated) {
    int i;
    uint32_t ip;
    char ip_str[32];

    printf("\n========== SERVER IP AVAILABILITY ==========\n");

    for (i = 0; i < num_subnets; i++) {

        printf("\nSubnet %d:\n", i + 1);

        for (ip = subnet_networks[i] + 1;
             ip < subnet_broadcasts[i];
             ip++) {

            ip_to_str(ip, ip_str);

            if (is_ip_allocated(ip,
                                allocated_ips,
                                total_allocated)) {

                char owner[100];

                find_ip_owner(ip,
                              allocated_ips,
                              allocated_clients,
                              total_allocated,
                              owner);

                printf("  %s - UNAVAILABLE (Client: %s)\n",
                       ip_str,
                       owner);
            }
            else {
                printf("  %s - AVAILABLE\n", ip_str);
            }
        }
    }

    printf("============================================\n");
}

int main(int argc, char *argv[]) {

    // 1. Verify Command Line Parameters
    if (argc < 3) {
        fprintf(stderr, "Usage: %s <Bind_IP> <Port>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    char *server_ip = argv[1];
    int port = atoi(argv[2]);

    int s;
    int n;

    char buffer[BUFFER_SIZE];

    struct sockaddr_in serverAddr;
    struct sockaddr_in clientAddr;
    socklen_t clntAddrLen;

    // --- Subnetting Input Variables ---

    char base_ip_str[100];

    int prefix;

    unsigned long long raw_org_pool_size = 0;
    unsigned long long org_pool_size = 0;

    int num_subnets = 0;

    unsigned long long raw_reqs[MAX_SUBNETS];
    unsigned long long allocated_sizes[MAX_SUBNETS];

    int subnet_prefixes[MAX_SUBNETS];

    uint32_t subnet_networks[MAX_SUBNETS];
    uint32_t subnet_broadcasts[MAX_SUBNETS];

    // ============================================================
    // IP ALLOCATION TABLE
    // ============================================================

    uint32_t allocated_ips[MAX_IPS];

    char allocated_clients[MAX_IPS][100];

    int total_allocated = 0;

    // 1. Interactive Server Base Pool Setup

    printf("--- Subnet Configuration Setup ---\n");

    printf("Enter Base IP Address (e.g., 14.23.23.0): ");
    scanf("%99s", base_ip_str);

    printf("Enter Subnet Prefix (e.g., 24): ");
    scanf("%d", &prefix);

    printf("Enter Total Address Range allocated for Organization: ");
    scanf("%llu", &raw_org_pool_size);

    // Automatically convert base organization pool to power of 2 ceiling
    org_pool_size =
        round_to_next_power_of_two(raw_org_pool_size);

    if (org_pool_size != raw_org_pool_size) {

        printf("Info: Organization range %llu changed to "
               "nearest highest power of 2: %llu\n",
               raw_org_pool_size,
               org_pool_size);
    }

    struct in_addr base_addr;

    if (inet_aton(base_ip_str, &base_addr) == 0) {

        fprintf(stderr,
                "ERROR: Invalid IP layout format entered.\n");

        exit(1);
    }

    uint32_t current_ip_ptr =
        ntohl(base_addr.s_addr);

    unsigned long long total_scheduled_ips = 0;

    // 2. Get Subnet Breakdown Requirements

    printf("\nEnter Number of Subnets needed: ");
    scanf("%d", &num_subnets);

    if (num_subnets > MAX_SUBNETS) {

        printf("ERROR: Exceeded maximum supported subnets (%d).\n",
               MAX_SUBNETS);

        exit(1);
    }

    int i;

    for (i = 0; i < num_subnets; i++) {

        printf("Enter Address Range (hosts) required for Subnet %d: ",
               i + 1);

        scanf("%llu", &raw_reqs[i]);

        // Automatically change to nearest highest power of 2
        allocated_sizes[i] =
            round_to_next_power_of_two(raw_reqs[i]);

        if (allocated_sizes[i] != raw_reqs[i]) {

            printf("Info: Subnet %d requirement scaled up "
                   "from %llu to %llu\n",
                   i + 1,
                   raw_reqs[i],
                   allocated_sizes[i]);
        }

        // Calculate dynamic CIDR prefix length
        int shift = 0;

        while ((allocated_sizes[i] >> shift) > 1)
            shift++;

        subnet_prefixes[i] = 32 - shift;

        // Assign Network and Broadcast boundaries

        subnet_networks[i] =
            current_ip_ptr;

        subnet_broadcasts[i] =
            current_ip_ptr +
            allocated_sizes[i] - 1;

        total_scheduled_ips +=
            allocated_sizes[i];

        // Advance pointer
        current_ip_ptr +=
            allocated_sizes[i];
    }

    // 3. Mathematical Validation

    printf("\n--- Validation Report ---\n");

    printf("Total Available IPs in Pool: %llu\n",
           org_pool_size);

    printf("Total Scheduled IPs for Subnets: %llu\n",
           total_scheduled_ips);

    if (total_scheduled_ips > org_pool_size) {

        printf("ERROR: We can't create the subnets as "
               "base address range is less than subnet requirement!\n");

        printf("Exiting server setup due to insufficient allocation space.\n");

        exit(1);
    }
    else {

        printf("SUCCESS: Subnet configuration mapped cleanly "
               "within base address range.\n\n");
    }

    // --- Standard UDP Initialization ---

    memset(&serverAddr, 0, sizeof(serverAddr));

    serverAddr.sin_family = AF_INET;

    serverAddr.sin_addr.s_addr =
        inet_addr(server_ip);

    serverAddr.sin_port =
        htons(port);

    if ((s = socket(PF_INET, SOCK_DGRAM, 0)) < 0) {

        perror("Error: Socket creation failed!");

        exit(1);
    }

    if (bind(s,
             (struct sockaddr*)&serverAddr,
             sizeof(serverAddr)) < 0) {

        perror("Error: Binding failed!");

        close(s);

        exit(1);
    }

    printf("[SERVER] Online on %s:%d. "
           "Awaiting Client Connections...\n\n",
           server_ip,
           port);

    // ============================================================
    // DHCP SERVER LOOP
    // ============================================================

    for (;;) {

        clntAddrLen =
            sizeof(clientAddr);

        // 1. Receive DISCOVER

        memset(buffer, 0, BUFFER_SIZE);

        n = recvfrom(s,
                     buffer,
                     BUFFER_SIZE - 1,
                     0,
                     (struct sockaddr*)&clientAddr,
                     &clntAddrLen);

        if (n <= 0)
            continue;

        buffer[n] = '\0';

        char client_name[100] = {0};

        sscanf(buffer,
               "DISCOVER:%99s",
               client_name);

        printf("[DHCP DISCOVER] Received from client name: %s\n",
               client_name);

        // ========================================================
        // BUILD DHCP OFFER
        // ========================================================

        char offer_payload[BUFFER_SIZE];

        memset(offer_payload,
               0,
               sizeof(offer_payload));

        char net_str[32];
        char bcast_str[32];
        char start_usable[32];
        char end_usable[32];
        char mask_str[32];

        for (i = 0; i < num_subnets; i++) {

            ip_to_str(subnet_networks[i],
                      net_str);

            ip_to_str(subnet_broadcasts[i],
                      bcast_str);

            ip_to_str(subnet_networks[i] + 1,
                      start_usable);

            ip_to_str(subnet_broadcasts[i] - 1,
                      end_usable);

            prefix_to_mask_str(subnet_prefixes[i],
                               mask_str);

            char temp[1024];

            snprintf(temp,
                     sizeof(temp),
                     "Subnet %d:\n"
                     "  - Requirement   : %llu addresses "
                     "(Allocated: %llu)\n"
                     "  - Prefix & Mask : /%d (%s)\n"
                     "  - Network / Bcast: %s / %s\n"
                     "  - Usable Range  : %s - %s\n",
                     i + 1,
                     raw_reqs[i],
                     allocated_sizes[i],
                     subnet_prefixes[i],
                     mask_str,
                     net_str,
                     bcast_str,
                     start_usable,
                     end_usable);

            strcat(offer_payload,
                   temp);

            // ====================================================
            // ADD IP AVAILABILITY TO DHCP OFFER
            // ====================================================

            uint32_t ip;

            for (ip = subnet_networks[i] + 1;
                 ip < subnet_broadcasts[i];
                 ip++) {

                char ip_string[32];

                ip_to_str(ip,
                          ip_string);

                char availability[256];

                if (is_ip_allocated(ip,
                                    allocated_ips,
                                    total_allocated)) {

                    char owner[100];

                    find_ip_owner(ip,
                                  allocated_ips,
                                  allocated_clients,
                                  total_allocated,
                                  owner);

                    snprintf(availability,
                             sizeof(availability),
                             "    %s - UNAVAILABLE "
                             "(Client: %s)\n",
                             ip_string,
                             owner);
                }
                else {

                    snprintf(availability,
                             sizeof(availability),
                             "    %s - AVAILABLE\n",
                             ip_string);
                }

                strcat(offer_payload,
                       availability);
            }

            strcat(offer_payload,
                   "\n");
        }

        // ========================================================
        // SEND DHCP OFFER
        // ========================================================

        sendto(s,
               offer_payload,
               strlen(offer_payload) + 1,
               0,
               (struct sockaddr*)&clientAddr,
               clntAddrLen);

        // ========================================================
        // DISPLAY SERVER AVAILABILITY
        // ========================================================

        display_ip_availability(
            num_subnets,
            subnet_networks,
            subnet_broadcasts,
            allocated_ips,
            allocated_clients,
            total_allocated);

        // ========================================================
        // RECEIVE DHCP REQUEST
        // ========================================================

        memset(buffer,
               0,
               BUFFER_SIZE);

        n = recvfrom(s,
                     buffer,
                     BUFFER_SIZE - 1,
                     0,
                     (struct sockaddr*)&clientAddr,
                     &clntAddrLen);

        if (n <= 0)
            continue;

        buffer[n] = '\0';

        int choice_idx = 0;

        sscanf(buffer,
               "REQUEST:%d",
               &choice_idx);

        choice_idx--;

        printf("[DHCP REQUEST] Client chosen Subnet Index: %d\n",
               choice_idx + 1);

        // ========================================================
        // COMPILE DHCP ACK
        // ========================================================

        char ack_payload[BUFFER_SIZE];

        memset(ack_payload,
               0,
               sizeof(ack_payload));

        if (choice_idx >= 0 &&
            choice_idx < num_subnets) {

            // ----------------------------------------------------
            // FIND FIRST AVAILABLE IP
            // ----------------------------------------------------

            uint32_t assigned_ip_value =
                find_available_ip(
                    subnet_networks[choice_idx],
                    subnet_broadcasts[choice_idx],
                    allocated_ips,
                    total_allocated);

            if (assigned_ip_value == 0) {

                sprintf(ack_payload,
                        "ERROR: No available IP addresses "
                        "in selected subnet.");

                printf("[DHCP ACK] No IP available "
                       "in Subnet %d.\n",
                       choice_idx + 1);
            }
            else {

                char assigned_ip[32];
                char net_addr[32];
                char bcast_addr[32];
                char sub_mask[32];

                // Convert IPs to strings

                ip_to_str(assigned_ip_value,
                          assigned_ip);

                ip_to_str(subnet_networks[choice_idx],
                          net_addr);

                ip_to_str(subnet_broadcasts[choice_idx],
                          bcast_addr);

                prefix_to_mask_str(
                    subnet_prefixes[choice_idx],
                    sub_mask);

                // ------------------------------------------------
                // STORE ALLOCATION PERMANENTLY ON SERVER
                // ------------------------------------------------

                if (total_allocated < MAX_IPS) {

                    allocated_ips[total_allocated] =
                        assigned_ip_value;

                    strcpy(
                        allocated_clients[total_allocated],
                        client_name);

                    total_allocated++;
                }
                else {

                    sprintf(ack_payload,
                            "ERROR: Server IP allocation "
                            "table is full.");

                    sendto(s,
                           ack_payload,
                           strlen(ack_payload) + 1,
                           0,
                           (struct sockaddr*)&clientAddr,
                           clntAddrLen);

                    continue;
                }

                // ------------------------------------------------
                // CREATE ACK
                // ------------------------------------------------

                sprintf(
                    ack_payload,
                    "Assigned IP       : %s\n"
                    "Subnet Mask       : %s\n"
                    "CIDR              : /%d\n"
                    "Network Address   : %s\n"
                    "Broadcast Address : %s\n",
                    assigned_ip,
                    sub_mask,
                    subnet_prefixes[choice_idx],
                    net_addr,
                    bcast_addr);

                printf("[DHCP ACK] Assigned IP %s to %s\n",
                       assigned_ip,
                       client_name);

                // ------------------------------------------------
                // DISPLAY UPDATED SERVER AVAILABILITY
                // ------------------------------------------------

                display_ip_availability(
                    num_subnets,
                    subnet_networks,
                    subnet_broadcasts,
                    allocated_ips,
                    allocated_clients,
                    total_allocated);
            }

        }
        else {

            sprintf(
                ack_payload,
                "ERROR: Invalid selection made. "
                "Out of index scope parameters.");
        }

        // ========================================================
        // SEND DHCP ACK
        // ========================================================

        sendto(s,
               ack_payload,
               strlen(ack_payload) + 1,
               0,
               (struct sockaddr*)&clientAddr,
               clntAddrLen);
    }

    close(s);

    return 0;
}
