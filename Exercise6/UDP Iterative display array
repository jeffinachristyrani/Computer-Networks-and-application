#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 65536

int main(int argc, char *argv[]) {

    // 1. Validate Command Line Arguments

    if (argc < 3) {

        fprintf(stderr,
                "Usage: %s <Server_IP> <Server_Port>\n",
                argv[0]);

        exit(EXIT_FAILURE);
    }

    char *server_ip = argv[1];

    int port = atoi(argv[2]);

    int sockfd;

    struct sockaddr_in server_addr;

    socklen_t addr_len =
        sizeof(server_addr);

    char buffer[BUFFER_SIZE];

    char client_name[100];

    // ============================================================
    // UDP SOCKET
    // ============================================================

    if ((sockfd =
         socket(AF_INET, SOCK_DGRAM, 0)) < 0) {

        perror("Socket creation failed");

        exit(EXIT_FAILURE);
    }

    memset(&server_addr,
           0,
           sizeof(server_addr));

    server_addr.sin_family =
        AF_INET;

    server_addr.sin_port =
        htons(port);

    server_addr.sin_addr.s_addr =
        inet_addr(server_ip);

    // ============================================================
    // CLIENT NAME
    // ============================================================

    printf("Enter Client Name: ");

    if (scanf("%99s", client_name) != 1) {

        fprintf(stderr,
                "Invalid input name.\n");

        close(sockfd);

        exit(EXIT_FAILURE);
    }

    printf("\nSending DHCP DISCOVER to server...\n\n");

    // ============================================================
    // SEND DHCP DISCOVER
    // ============================================================

    sprintf(buffer,
            "DISCOVER:%s",
            client_name);

    sendto(sockfd,
           buffer,
           strlen(buffer) + 1,
           0,
           (const struct sockaddr *)&server_addr,
           addr_len);

    // ============================================================
    // RECEIVE DHCP OFFER
    // ============================================================

    memset(buffer,
           0,
           BUFFER_SIZE);

    int n =
        recvfrom(sockfd,
                 buffer,
                 BUFFER_SIZE - 1,
                 0,
                 (struct sockaddr *)&server_addr,
                 &addr_len);

    if (n <= 0) {

        fprintf(stderr,
                "Error receiving data from server "
                "or timeout occurred.\n");

        close(sockfd);

        exit(EXIT_FAILURE);
    }

    buffer[n] = '\0';

    // ============================================================
    // ERROR CHECK
    // ============================================================

    if (strncmp(buffer,
                "ERROR",
                5) == 0) {

        printf("[SERVER ERROR] %s\n",
               buffer);

        close(sockfd);

        exit(EXIT_FAILURE);
    }

    // ============================================================
    // DISPLAY DHCP OFFER
    // ============================================================

    printf("========== RECEIVED DHCP OFFER ==========\n");

    printf("%s",
           buffer);

    printf("=========================================\n");

    // ============================================================
    // DISPLAY IP AVAILABILITY ON CLIENT SIDE
    // ============================================================

    printf("\n========== CLIENT IP AVAILABILITY ==========\n");

    char offer_copy[BUFFER_SIZE];

    strcpy(offer_copy,
           buffer);

    char *line =
        strtok(offer_copy,
               "\n");

    while (line != NULL) {

        if (strstr(line,
                   " - AVAILABLE") != NULL ||
            strstr(line,
                   " - UNAVAILABLE") != NULL) {

            printf("%s\n",
                   line);
        }

        line =
            strtok(NULL,
                   "\n");
    }

    printf("============================================\n");

    // ============================================================
    // CHOOSE SUBNET
    // ============================================================

    int choice;

    printf("\nEnter subnet choice (1-3): ");

    if (scanf("%d",
              &choice) != 1) {

        choice = 1;
    }

    printf("\nSending DHCP REQUEST for Subnet %d...\n\n",
           choice);

    // ============================================================
    // SEND DHCP REQUEST
    // ============================================================

    sprintf(buffer,
            "REQUEST:%d",
            choice);

    sendto(sockfd,
           buffer,
           strlen(buffer) + 1,
           0,
           (const struct sockaddr *)&server_addr,
           addr_len);

    // ============================================================
    // RECEIVE DHCP ACK
    // ============================================================

    memset(buffer,
           0,
           BUFFER_SIZE);

    n =
        recvfrom(sockfd,
                 buffer,
                 BUFFER_SIZE - 1,
                 0,
                 (struct sockaddr *)&server_addr,
                 &addr_len);

    if (n <= 0) {

        fprintf(stderr,
                "Error receiving confirmation ACK payload.\n");

        close(sockfd);

        exit(EXIT_FAILURE);
    }

    buffer[n] = '\0';

    // ============================================================
    // DISPLAY ACK
    // ============================================================

    printf("========== DHCP INFORMATION ACKNOWLEDGED ==========\n\n");

    printf("Client Name       : %s\n",
           client_name);

    printf("%s",
           buffer);

    printf("\n===================================================\n");

    // ============================================================
    // SHOW THE ASSIGNED IP AS UNAVAILABLE
    // ============================================================

    if (strncmp(buffer,
                "ERROR",
                5) != 0) {

        char assigned_ip[32];

        if (sscanf(buffer,
                   "Assigned IP       : %31s",
                   assigned_ip) == 1) {

            printf("\n========== UPDATED CLIENT STATUS ==========\n");

            printf("%s - UNAVAILABLE (Client: %s)\n",
                   assigned_ip,
                   client_name);

            printf("===========================================\n");
        }
    }

    close(sockfd);

    return 0;
}
