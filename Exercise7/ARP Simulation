#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <signal.h>

#define BUFFER_SIZE 1024

void chat(int client_socket)
{
    char buffer[BUFFER_SIZE];
    char username[50];

    // Receive username
    int n = recv(client_socket, username, sizeof(username) - 1, 0);

    if (n <= 0)
    {
        close(client_socket);
        exit(0);
    }

    username[n] = '\0';

    printf("\n%s connected.\n", username);

    // Send acknowledgement
    send(client_socket, "OK", 3, 0);

    while (1)
    {
        // Receive message from client
        memset(buffer, 0, BUFFER_SIZE);

        n = recv(client_socket,
                 buffer,
                 BUFFER_SIZE - 1,
                 0);

        if (n <= 0)
        {
            printf("%s disconnected.\n", username);
            break;
        }

        buffer[n] = '\0';

        printf("%s: %s", username, buffer);

        if (strncmp(buffer, "exit", 4) == 0)
            break;

        // Send message to client
        printf("Server: ");
        fgets(buffer, BUFFER_SIZE, stdin);

        send(client_socket,
             buffer,
             strlen(buffer),
             0);

        if (strncmp(buffer, "exit", 4) == 0)
            break;
    }

    close(client_socket);
    exit(0);
}


void start_server(char *ip, int port)
{
    int server_socket, client_socket;

    struct sockaddr_in server_addr, client_addr;

    socklen_t client_len = sizeof(client_addr);

    server_socket = socket(AF_INET, SOCK_STREAM, 0);

    if (server_socket < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    printf("Server socket created successfully.\n");

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);
    server_addr.sin_addr.s_addr = inet_addr(ip);

    if (bind(server_socket,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }

    listen(server_socket, 5);

    printf("Server is listening on port %d...\n", port);

    signal(SIGCHLD, SIG_IGN);

    while (1)
    {
        printf("\nWaiting for client...\n");

        client_socket = accept(server_socket,
                               (struct sockaddr *)&client_addr,
                               &client_len);

        if (client_socket < 0)
            continue;

        printf("Client connected.\n");

        if (fork() == 0)
        {
            close(server_socket);
            chat(client_socket);
        }

        close(client_socket);
    }
}


int main(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <IP Address> <Port>\n", argv[0]);
        return 1;
    }

    start_server(argv[1], atoi(argv[2]));

    return 0;
}
