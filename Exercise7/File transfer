#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define BUFFER_SIZE 1024


// Function to receive file from server
void receive_file(int client_socket)
{
    char filename[256];
    char output_filename[300];
    char buffer[BUFFER_SIZE];

    FILE *file;

    long file_size;
    long received_size = 0;

    int bytes_received;

    // Ask for filename
    printf("\nEnter filename to download: ");
    scanf("%255s", filename);

    // Send filename to server
    send(client_socket,
         filename,
         strlen(filename) + 1,
         0);

    // Receive file size
    if (recv(client_socket,
             &file_size,
             sizeof(file_size),
             0) <= 0)
    {
        printf("Server disconnected.\n");
        return;
    }

    // Check if file exists
    if (file_size < 0)
    {
        printf("File not found on server.\n");
        return;
    }

    // Display file information
    printf("\n========== FILE INFORMATION ==========\n");
    printf("File Name : %s\n", filename);
    printf("File Size : %ld bytes\n", file_size);

    // Create output filename
    snprintf(output_filename,
             sizeof(output_filename),
             "received_%s",
             filename);

    // Open output file
    file = fopen(output_filename, "wb");

    if (file == NULL)
    {
        perror("File creation failed");
        return;
    }

    printf("\nReceiving file...\n");

    // Receive file contents
    while (received_size < file_size)
    {
        bytes_received = recv(client_socket,
                              buffer,
                              BUFFER_SIZE,
                              0);

        if (bytes_received <= 0)
        {
            printf("Connection lost during transfer.\n");
            break;
        }

        fwrite(buffer,
               1,
               bytes_received,
               file);

        received_size += bytes_received;
    }

    fclose(file);

    // Check transfer status
    if (received_size == file_size)
    {
        printf("File received successfully.\n");
    }
    else
    {
        printf("File transfer incomplete.\n");
        return;
    }

    // Display received file
    file = fopen(output_filename, "rb");

    if (file == NULL)
    {
        perror("Cannot open received file");
        return;
    }

    printf("\n========== RECEIVED FILE CONTENT ==========\n");

    while (fgets(buffer, BUFFER_SIZE, file) != NULL)
    {
        printf("%s", buffer);
    }

    printf("\n===========================================\n");

    fclose(file);

    printf("\nSaved as       : %s\n", output_filename);
    printf("Received size  : %ld bytes\n", received_size);
}


// Function to start the client
void start_client(char *ip, int port)
{
    int client_socket;

    struct sockaddr_in server_addr;

    // Create socket
    client_socket = socket(AF_INET,
                           SOCK_STREAM,
                           0);

    if (client_socket < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    printf("Client socket created successfully.\n");

    // Configure server address
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);
    server_addr.sin_addr.s_addr = inet_addr(ip);

    // Connect to server
    if (connect(client_socket,
                (struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0)
    {
        perror("Connection failed");
        close(client_socket);
        exit(1);
    }

    printf("Connected to server.\n");

    // Receive file
    receive_file(client_socket);

    close(client_socket);
}


// Main function
int main(int argc, char *argv[])
{
    // Check command-line arguments
    if (argc != 3)
    {
        printf("Usage: %s <Server IP> <Port>\n", argv[0]);
        return 1;
    }

    // Start client
    start_client(argv[1], atoi(argv[2]));

    return 0;
}
